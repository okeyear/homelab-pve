.env.mcp
.omo
__pycache__/

# vmware-k8s 的运行时产物:装好的 packer(100MB+)、下载的 ISO、
# 生成的 autoinstall user-data、中间状态文件。
vmware-k8s/.cache/
# 测试跑完可能残留的临时文件(正常会被清掉,测试崩了就会留下)
vmware-k8s/tests/_*
# packer build 的产物:一张 20G 的模板盘 + 生成的变量文件 + manifest
vmware-k8s/packer/output/
vmware-k8s/packer/*.pkrvars.hcl
vmware-k8s/packer/manifest.json
# packer 自己的缓存(ISO 副本,又 2.7G)
vmware-k8s/packer/packer_cache/
# packer build 时自己写的锁文件
vmware-k8s/packer/manifest.json.lock
# k8s 阶段跑完自动生成的集群配置(里面是这台机器的实际 IP,
# 由 vmware-k8s/build.ps1 写;仓库里留的是 config.sh.example)
setup-k8s/config.sh